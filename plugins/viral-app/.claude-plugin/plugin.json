{
  "name": "viral-app",
  "version": "0.2.0",
  "description": "Connect viral.app to your agent: OAuth MCP server with 50+ tools for social analytics, account/video tracking, tags and workflows, Creator Hub, and live TikTok/Instagram/YouTube lookups, plus a usage skill.",
  "author": {
    "name": "FMD Labs",
    "url": "https://viral.app"
  },
  "homepage": "https://viral.app/app/org/api/agents",
  "repository": "https://github.com/fmd-labs/viral-app-agents",
  "license": "MIT",
  "keywords": [
    "viral.app",
    "mcp",
    "social-analytics",
    "tiktok",
    "instagram",
    "youtube",
    "ugc",
    "creator-marketing"
  ],
  "commands": [
    "./channel/commands/configure-events.md"
  ],
  "mcpServers": {
    "viral_app": {
      "type": "http",
      "url": "https://viral.app/api/mcp"
    },
    "viral_app_events": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/channel/dist/server.mjs"
      ]
    }
  }
}
